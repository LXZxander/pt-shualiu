[Unit]
Description=PT Shualiu daemon
After=network-online.target qbittorrent-nox.service
Wants=network-online.target

[Service]
Type=simple
User=<你的用户名>
WorkingDirectory=/path/to/pt_shualiu
ExecStart=/path/to/pt_shualiu/.venv/bin/python -m pt_shualiu.daemon
Restart=on-failure
RestartSec=10
EnvironmentFile=/path/to/pt_shualiu/.env
# Fix round 3（TZ）：每日 09:00 邮件按北京时间触发。daemon 邮件门限用 now.astimezone()
# 取宿主本地时区（原为 Etc/UTC → 17:00 北京才发）。设进程 TZ 后 astimezone() 解析为北京。
# 注意：种龄/保种窗口等 UTC 时间数学不受影响（代码显式用 UTC）。
Environment=TZ=Asia/Shanghai

[Install]
WantedBy=multi-user.target
